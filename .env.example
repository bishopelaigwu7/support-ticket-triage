# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for drafting. Check https://docs.claude.com/en/docs/about-claude/models
# for the current list of available model IDs -- this is left configurable on purpose
# since model names change over time.
ANTHROPIC_MODEL=claude-sonnet-4-5

# How many similar knowledge-base articles / past tickets to retrieve as context.
RETRIEVAL_TOP_K=3
